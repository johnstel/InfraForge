# InfraForge demo environment template
# Copy to .env and replace placeholder values via your secret manager.

ENTRA_CLIENT_ID=REPLACE_WITH_ENTRA_CLIENT_ID
ENTRA_TENANT_ID=REPLACE_WITH_ENTRA_TENANT_ID
ENTRA_CLIENT_SECRET=REPLACE_WITH_ENTRA_CLIENT_SECRET
ENTRA_REDIRECT_URI=http://localhost:8080/api/auth/callback

AZURE_SQL_CONNECTION_STRING=REPLACE_WITH_AZURE_SQL_CONNECTION_STRING
AZURE_SUBSCRIPTION_ID=REPLACE_WITH_AZURE_SUBSCRIPTION_ID
AZURE_SQL_SERVER=REPLACE_WITH_AZURE_SQL_SERVER
AZURE_RESOURCE_GROUP=InfraForge

GITHUB_TOKEN=REPLACE_WITH_GITHUB_TOKEN
GITHUB_ORG=REPLACE_WITH_GITHUB_ORG

COPILOT_MODEL=gpt-4.1
COPILOT_LOG_LEVEL=warning

INFRAFORGE_WEB_HOST=0.0.0.0
INFRAFORGE_WEB_PORT=8080
INFRAFORGE_SESSION_SECRET=REPLACE_WITH_INFRAFORGE_SESSION_SECRET
INFRAFORGE_OUTPUT_DIR=./output

FABRIC_WORKSPACE_ID=
FABRIC_ONELAKE_DFS_ENDPOINT=
FABRIC_LAKEHOUSE_NAME=

WORKIQ_ENABLED=true
WORKIQ_TIMEOUT=90
